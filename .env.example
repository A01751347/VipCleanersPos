# =============================================================================
# VipCleaners POS — variables de entorno
# Copia este archivo a .env y llena los valores. NUNCA subas .env al repo.
# =============================================================================

# --- Base de datos (PostgreSQL) ---------------------------------------------
DATABASE_URL=postgresql://usuario:contrasena@host:5432/vipcleaners
# Pon 'require' cuando la base esté en otro servidor (siempre en producción)
DB_SSL=
DB_POOL_MAX=10

# --- Autenticación ----------------------------------------------------------
# En producción, el dominio real con https. Se lee en tiempo de ejecución.
NEXTAUTH_URL=http://localhost:3000
# Genera uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Cloudflare Turnstile (anti-spam del sitio público) ---------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sólo funciona fuera de producción
SKIP_TURNSTILE=

# --- Almacenamiento de archivos (S3) ----------------------------------------
# El bucket debe ser PRIVADO, con Block Public Access activado.
# Las imágenes se sirven con URLs firmadas de 5 minutos.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Correo -----------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- WhatsApp Business (opcional) -------------------------------------------
# Sin estas dos variables, los avisos por WhatsApp simplemente no se envían.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Datos del negocio (respaldo si no están en configuracion_sistema) ------
COMPANY_NAME=VIP Cleaners
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_WEBSITE=

# --- Migración desde MySQL (sólo para el script de migración) ---------------
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
