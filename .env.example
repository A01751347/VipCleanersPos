# Base de datos
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# NextAuth (Autenticación)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate_a_random_long_secret_here

# Admin (opcional - para script de creación de admin)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure_password_here

# Email (SMTP)
EMAIL_PROVIDER=smtp-relay.brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_from_email@domain.com

# Company Info
COMPANY_NAME="Your Company Name"
COMPANY_EMAIL="contact@yourdomain.com"
COMPANY_PHONE="+52 55 1234 5678"
COMPANY_ADDRESS="Your Address"
COMPANY_WEBSITE="https://yourdomain.com"

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-2
AWS_S3_BUCKET=your_bucket_name

# Mercado Pago Point Smart Integration
# Obtén estas credenciales en: https://www.mercadopago.com.mx/developers/panel
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_USER_ID=your_mercadopago_user_id
MERCADOPAGO_EXTERNAL_STORE_ID=your_store_id
MERCADOPAGO_EXTERNAL_POS_ID=your_pos_id

# Webhooks URL (para producción)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
